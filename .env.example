# Base URL
LOCAL_API_BASE_URL=http://localhost:8000/api/v1
DEV_API_BASE_URL=https://dev.i-deal.uz/api/v1
PROD_API_BASE_URL=https://i-deal.uz/api/v1

# Public web application base URLs used by the in-app privacy-policy WebView.
# Leave local empty until the frontend is reachable from the simulator/device.
LOCAL_FRONTEND_BASE_URL=
DEV_FRONTEND_BASE_URL=https://dev.i-deal.uz
PROD_FRONTEND_BASE_URL=https://i-deal.uz

# Optional direct support channels. Use full HTTPS URLs, for example a t.me
# link and a wa.me link. Empty values hide the respective option in the app.
SUPPORT_TELEGRAM_URL=
SUPPORT_WHATSAPP_URL=

# MS Clarity
CLARITY_PROJECT_ID_PROD=

# Map Token Obfuscation
MAP_OBFUSCATION_SECRET=iDeal-Secret-Map-Seed-2025
