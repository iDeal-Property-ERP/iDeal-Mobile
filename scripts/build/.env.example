# ============================================================================
# iDeal Mobile — release configuration
#
# Copy this file to scripts/build/.env and fill in the real values:
#
#     cp scripts/build/.env.example scripts/build/.env
#
# Notes:
#   • scripts/build/.env is GITIGNORED — safe place for secrets.
#   • Relative paths are resolved against scripts/build/.
#   • Every value can be overridden per-invocation with script flags
#     (see --help of each script).
# ============================================================================

# ── Defaults (optional) ──────────────────────────────────────────────────────
DEFAULT_FLAVOR=prod
DEFAULT_ANDROID_FORMAT=aab
DEFAULT_PLAY_TRACK=internal
DEFAULT_IOS_TARGET=testflight

# ── iOS · App Store Connect API key ─────────────────────────────────────────
# Create at: https://appstoreconnect.apple.com → Users and Access → Integrations
# → App Store Connect API → generate a key with "App Manager" role.
# Download the .p8 file and store it under scripts/build/.secrets/ios/.
#
# APP_STORE_CONNECT_KEY_ID=ABC123XYZ9
# APP_STORE_CONNECT_ISSUER_ID=69a6de7d-0000-1111-2222-333344445555
# APP_STORE_CONNECT_KEY_FILE=.secrets/ios/AuthKey_ABC123XYZ9.p8

# iOS bundle identifiers used by ios/upload.sh (must match Xcode project).
IOS_BUNDLE_ID_PROD=com.ideal.mobile
IOS_BUNDLE_ID_DEV=com.ideal.mobile.dev

# ── Android · Google Play service account ───────────────────────────────────
# Create at: https://console.cloud.google.com → enable "Android Publisher API"
# → create a service account → download JSON key → grant it access to your app
# in Play Console (Users and permissions).
#
# ANDROID_PLAY_SERVICE_ACCOUNT_JSON=.secrets/android/play-service-account.json

# Android application IDs used by android/upload.sh (must match build.gradle).
ANDROID_PACKAGE_NAME_PROD=com.ideal.uz
ANDROID_PACKAGE_NAME_DEV=com.ideal.uz.dev

# ── Java (optional — auto-detected when unset) ──────────────────────────────
# JAVA_HOME=/Applications/Android Studio.app/Contents/jbr/Contents/Home
